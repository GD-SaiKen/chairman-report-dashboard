{
  "name": "chairman-report-dashboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "信息部与 Hermes 项目报告的一屏判断面板（零依赖静态站点）",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node --test",
    "check": "node --test && node --check js/app.js && node --check js/core/snapshot-contract.js && node --check manage/import/app.js && node --check server/app.mjs",
    "import:check": "node scripts/check-import-storage.mjs",
    "snapshot:build": "node scripts/build-snapshot.mjs",
    "snapshot:validate": "node scripts/validate-snapshot.mjs",
    "data:init": "node scripts/init-data.mjs",
    "radar:collect": "node scripts/collect-radar.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "parse5": "^7.3.0"
  }
}
